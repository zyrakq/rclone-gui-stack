# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=rclone-gui

# Docker image
IMAGE=decovar/rclone-rc-web-gui:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

TZ=Etc/UTC

RCLONE_USER=admin
